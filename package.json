{
  "name": "jarfi",
  "version": "4.2.1",
  "description": "JARFI NOC - AI-Powered Network Operation Center for ISP management",
  "private": true,
  "author": "Supriyanto",
  "repository": {
    "type": "git",
    "url": "https://github.com/abadijayacopier/jarfi.git"
  },
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build && xcopy /E /I /Y public .next\\standalone\\public && xcopy /E /I /Y .next\\static .next\\standalone\\.next\\static",
    "start": "next start",
    "lint": "eslint",
    "electron-dev": "electron .",
    "generate-icon": "node scripts/convert-icon.js",
    "download-mariadb": "node scripts/download-mariadb.js",
    "electron-pack": "node scripts/download-mariadb.js && node scripts/convert-icon.js && npm run build && electron-builder build --win --publish never",
    "bot": "node scripts/dunia-wifi-bot.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.3.1",
    "electron-updater": "^6.8.3",
    "jose": "^6.2.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.8.0",
    "mysql2": "^3.20.0",
    "next": "16.2.1",
    "node-telegram-bot-api": "^0.67.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.8.1",
    "routeros-client": "^1.1.1",
    "source-map-support": "^0.5.21",
    "sweetalert2": "^11.26.24",
    "telnet-client": "^2.2.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "electron-serve": "^3.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.jarfi.noc",
    "productName": "JARFI NOC",
    "publish": [
      {
        "provider": "github",
        "owner": "abadijayacopier",
        "repo": "jarfi"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "JARFI NOC",
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    },
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "extraResources/mariadb",
        "to": "mariadb",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "scripts/setup-jarfi-db.bat",
        "to": "mariadb/setup-jarfi-db.bat"
      }
    ],
    "files": [
      "electron/**/*",
      "public/**/*",
      ".next/standalone/**/*",
      ".next/static/**/*",
      "schema.sql",
      "package.json",
      "build/installer.nsh"
    ],
    "asarUnpack": [
      ".next/standalone/**/*",
      "schema.sql"
    ]
  }
}