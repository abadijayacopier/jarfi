{
  "name": "jarfi",
  "version": "4.1.0",
  "private": true,
  "author": "Supriyanto",
  "repository": {
    "type": "git",
    "url": "https://github.com/abadijayacopier/jarfi.git"
  },
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron-dev": "electron .",
    "electron-pack": "electron-builder build --win --publish never"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.3.1",
    "electron-updater": "^6.8.3",
    "jose": "^6.2.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.8.0",
    "mysql2": "^3.20.0",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.8.1",
    "routeros-client": "^1.1.1",
    "source-map-support": "^0.5.21",
    "sweetalert2": "^11.26.24"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "electron-serve": "^3.0.1",
